---
import { getCollection } from 'astro:content'
import { SITE } from '../consts'
import ThemeToggle from './ThemeToggle.astro'

type Props = { activeSlug?: string }
const { activeSlug } = Astro.props

// The nav IS the content collection — adding a module .mdx adds a nav entry,
// with no second list to keep in step. The old site kept its routes in a
// hand-maintained array in router.jsx.
const modules = (await getCollection('modules', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<header
  class="sticky top-0 z-50 border-b backdrop-blur"
  style="background: color-mix(in srgb, var(--bg) 88%, transparent); border-color: var(--border)"
>
  <div class="mx-auto max-w-5xl px-4">
    <div class="flex h-14 items-center justify-between gap-3">
      <a href="/" class="flex items-center gap-2 font-semibold tracking-tight shrink-0">
        <span
          class="inline-block h-2.5 w-2.5 rounded-full"
          style="background: var(--color-amber); box-shadow: 0 0 10px var(--glow)"
          aria-hidden="true"></span>
        <span class="hidden sm:inline">{SITE.name}</span>
        <span class="sm:hidden">{SITE.shortName}</span>
      </a>

      <div class="flex items-center gap-1">
        <ThemeToggle />
        <button
          type="button"
          id="nav-toggle"
          class="lg:hidden rounded px-2.5 py-1.5 text-sm border"
          style="border-color: var(--border)"
          aria-expanded="false"
          aria-controls="nav-modules"
        >
          Modules
        </button>
      </div>
    </div>

    {/* Horizontal on desktop, collapsible on phones. No jQuery, no Bootstrap —
        the old site shipped 324KB of vendor JS whose only job was this. */}
    <nav
      id="nav-modules"
      class="hidden lg:block pb-2 lg:pb-0"
      aria-label="Modules"
    >
      <ul class="flex flex-col lg:flex-row lg:flex-wrap gap-x-1 gap-y-0.5 pb-2 text-sm">
        {
          modules.map((m) => (
            <li>
              <a
                href={`/modules/${m.id}/`}
                class="block rounded px-2 py-1 transition-colors hover:opacity-100"
                style={
                  activeSlug === m.id
                    ? 'color: var(--color-amber); background: var(--bg-elev-2)'
                    : 'color: var(--text-muted)'
                }
                aria-current={activeSlug === m.id ? 'page' : undefined}
              >
                {m.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle')
  const nav = document.getElementById('nav-modules')

  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false
    toggle.setAttribute('aria-expanded', String(open))
  })

  // Collapse after navigating on a phone, so the list does not cover the page
  // you just asked for.
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName !== 'A') return
    if (window.matchMedia('(min-width: 1024px)').matches) return
    nav.classList.add('hidden')
    toggle?.setAttribute('aria-expanded', 'false')
  })
</script>
