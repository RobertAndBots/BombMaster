---
// Dark is the default; light is an accommodation someone opts into, and that
// choice persists. BaseLayout's inline script applies it before first paint.
---

<button
  type="button"
  id="theme-toggle"
  class="rounded px-2 py-1.5 text-sm border"
  style="border-color: var(--border); color: var(--text-muted)"
  aria-label="Toggle light and dark theme"
>
  <span aria-hidden="true" data-theme-icon>&#9789;</span>
</button>

<script>
  const btn = document.getElementById('theme-toggle')
  const icon = btn?.querySelector('[data-theme-icon]')

  const sync = () => {
    const light = document.documentElement.classList.contains('light')
    if (icon) icon.textContent = light ? '☼' : '☽'
  }

  sync()

  btn?.addEventListener('click', () => {
    const root = document.documentElement
    const light = root.classList.toggle('light')
    root.classList.toggle('dark', !light)
    try {
      localStorage.setItem('kth-theme', light ? 'light' : 'dark')
    } catch {}
    sync()
  })
</script>
