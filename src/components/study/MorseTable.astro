---
import { GROUPS, WORDS, encode, frequencyOf } from '../../lib/rules/morse-code'
---

<div class="not-prose my-4 grid grid-cols-2 sm:grid-cols-4 gap-3">
  {
    GROUPS.map((group, gi) => (
      <div class="rounded border p-3" style="border-color: var(--border); background: var(--bg-elev)">
        <h4 class="text-xs font-semibold mb-1.5" style="color: var(--text-faint)">
          Group {gi + 1}
        </h4>
        <ol class="text-sm space-y-0.5">
          {group.map((word) => (
            <li class="flex justify-between gap-2">
              <span>{word}</span>
              <span class="tabular-nums text-xs" style="color: var(--text-faint)">{frequencyOf(word)}</span>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</div>

<details class="not-prose my-4 rounded border p-3" style="border-color: var(--border)">
  <summary class="cursor-pointer text-sm font-medium">All sixteen words in Morse</summary>
  <div class="scroll-x mt-3">
    <table class="w-full text-sm">
      <tbody>
        {
          WORDS.map((entry) => (
            <tr>
              <td class="py-1 pr-3">{entry.word}</td>
              <td class="py-1 pr-3 font-mono text-xs" style="color: var(--color-amber)">
                {encode(entry.word).join('   ')}
              </td>
              <td class="py-1 tabular-nums text-xs" style="color: var(--text-faint)">{entry.frequency} MHz</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</details>
