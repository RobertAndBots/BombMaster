---
import { COLORS, MAPPINGS, MAX_STRIKES } from '../../lib/rules/simon-says'

const SWATCH: Record<string, string> = {
  Red: 'var(--color-wire-red)',
  Blue: 'var(--color-wire-blue)',
  Green: 'var(--color-good)',
  Yellow: 'var(--color-wire-yellow)',
}

const tables = [
  { key: 'vowel' as const, label: 'Serial contains a vowel' },
  { key: 'noVowel' as const, label: 'Serial has no vowel' },
]
---

<div class="not-prose my-4 grid grid-cols-1 sm:grid-cols-2 gap-4">
  {
    tables.map((t) => (
      <div class="rounded border overflow-hidden" style="border-color: var(--border)">
        <h4 class="px-3 py-2 text-sm font-semibold" style="background: var(--bg-elev-2)">{t.label}</h4>
        <table class="w-full text-sm">
          <thead>
            <tr style="color: var(--text-faint)">
              <th class="p-2 text-left font-normal text-xs">Flash</th>
              {
                Array.from({ length: MAX_STRIKES + 1 }, (_, s) => (
                  <th class="p-2 font-normal text-xs">{s === 0 ? 'No strikes' : s === 1 ? '1 strike' : '2 strikes'}</th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              COLORS.map((flash) => (
                <tr>
                  <th class="p-2 text-left font-medium">
                    <span class="inline-flex items-center gap-1.5">
                      <span class="inline-block h-2.5 w-2.5 rounded-full" style={`background: ${SWATCH[flash]}`} />
                      {flash}
                    </span>
                  </th>
                  {
                    MAPPINGS[t.key].map((mapping) => (
                      <td class="p-2 text-center">
                        <span class="inline-flex items-center gap-1.5" style="color: var(--text-muted)">
                          <span class="inline-block h-2.5 w-2.5 rounded-full" style={`background: ${SWATCH[mapping[flash]]}`} />
                          {mapping[flash]}
                        </span>
                      </td>
                    ))
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    ))
  }
</div>
