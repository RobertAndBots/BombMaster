---
import { GROUP_1, GROUP_2, studyList, type ButtonLabel } from '../../lib/rules/whos-on-first'

// One row per step-1 label: the sentence, and under it the (truncated) list
// the sentence encodes, so the two can be checked against each other.
type Props = { group: 1 | 2; sentences: Record<string, string> }
const { group, sentences } = Astro.props

const labels = (group === 1 ? GROUP_1 : GROUP_2) as readonly ButtonLabel[]
---

<ol class="my-4 grid grid-cols-2 sm:grid-cols-3 gap-x-6">
  {labels.map((label) => <li>{label}</li>)}
</ol>

<slot />

<div class="not-prose my-4 space-y-2">
  {
    labels.map((label) => {
      const [sentence, note] = (sentences[label] ?? '').split(' | ')
      return (
        <div class="rounded border p-3" style="border-color: var(--border); background: var(--bg-elev)">
          <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
            <h4 class="text-sm font-semibold" style="color: var(--color-amber)">{label}</h4>
            <p class="text-sm">
              {sentence}
              {note && <i style="color: var(--text-muted)"> {note}</i>}
            </p>
          </div>
          <p class="mt-1 text-xs" style="color: var(--text-faint)">{studyList(label).join(', ')}</p>
        </div>
      )
    })
  }
</div>
