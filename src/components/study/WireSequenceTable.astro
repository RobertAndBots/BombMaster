---
import { CHUNKS, SEQUENCE_COLORS, TABLE } from '../../lib/rules/wire-sequences'
---

<div class="not-prose my-4 grid grid-cols-1 sm:grid-cols-3 gap-3">
  {
    SEQUENCE_COLORS.map((color) => (
      <div class="rounded border p-3" style="border-color: var(--border); background: var(--bg-elev)">
        <h4 class="text-sm font-semibold mb-2">{color}</h4>
        <ol class="text-sm tabular-nums space-y-0.5" style="color: var(--text-muted)">
          {TABLE[color].map((row, i) => (
            <li class="flex gap-3">
              <span style="color: var(--text-faint)">{i + 1}</span>
              <span class="font-mono font-semibold" style="color: var(--text)">{row}</span>
            </li>
          ))}
        </ol>
      </div>
    ))
  }
</div>

<div class="not-prose my-4 space-y-3">
  {
    SEQUENCE_COLORS.map((color) => (
      <div>
        <h4 class="text-sm font-semibold mb-1">{color}</h4>
        <ul class="space-y-1 text-sm" style="color: var(--text-muted)">
          {CHUNKS[color].map((chunk) => (
            <li>
              <strong class="font-mono" style="color: var(--color-amber)">{chunk.rows.join(', ')}</strong>
              {' — '}
              {chunk.note}
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
