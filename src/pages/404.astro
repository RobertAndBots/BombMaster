---
import BaseLayout from '../layouts/BaseLayout.astro'

// A real 404. The old Express server returned 200 with the app shell for every
// unknown path, including nested asset paths — bad for indexing a site whose
// whole value is being findable and shareable.
---

<BaseLayout title="Not found" description="That page does not exist.">
  <div class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="text-5xl font-semibold" style="color: var(--color-amber)">404</p>
    <h1 class="mt-3 text-2xl font-semibold">That module is not on this bomb.</h1>
    <p class="mt-2" style="color: var(--text-muted)">The page you asked for does not exist.</p>
    <a
      href="/"
      class="mt-6 inline-block rounded border px-4 py-2 text-sm"
      style="border-color: var(--color-amber); color: var(--color-amber)"
    >
      Back to the modules
    </a>
  </div>
</BaseLayout>
