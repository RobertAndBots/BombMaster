---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { EXTERNAL_RESOURCES, MANUAL_URL, SITE } from '../consts'

const showDrafts = import.meta.env.SHOW_DRAFTS === '1'
const modules = (await getCollection('modules', ({ data }) => showDrafts || !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<BaseLayout>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <section class="mb-14">
      <h1 class="text-4xl font-semibold tracking-tight">{SITE.name}</h1>
      <div class="prose mt-5">
        <p>
          Let's memorize the <a href={MANUAL_URL} target="_blank" rel="noopener">Bomb Defusal Manual</a>!
          On this website I'll describe the techniques I used to help me memorize the modules. Keep in
          mind that people memorize things in different ways, so use this as a guide but come up with a
          method that works best for you.
        </p>
      </div>
    </section>

    <section class="mb-14">
      <h2 class="text-sm font-semibold uppercase tracking-wide mb-4" style="color: var(--text-faint)">
        The modules
      </h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {
          modules.map((m) => (
            <li>
              <a
                href={`/modules/${m.id}/`}
                class="block h-full rounded-lg border p-3.5 transition-colors"
                style="border-color: var(--border); background: var(--bg-elev)"
              >
                <h3 class="font-medium">{m.data.title}</h3>
                {m.data.hasDrill && (
                  <span class="mt-1 inline-block text-xs" style="color: var(--color-amber)">
                    Learn &middot; Practice
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wide mb-4" style="color: var(--text-faint)">
        External resources
      </h2>
      <p class="mb-3" style="color: var(--text-muted)">
        Here's a list of other resources and guides you may find useful.
      </p>
      <ul class="space-y-2.5">
        {
          EXTERNAL_RESOURCES.map((r) => (
            <li>
              <a
                href={r.href}
                target="_blank"
                rel="noopener"
                class="font-medium underline underline-offset-2"
                style="color: var(--color-amber)"
              >
                {r.label}
              </a>
            </li>
          ))
        }
      </ul>
      <h2 class="mt-14 text-sm font-semibold uppercase tracking-wide mb-4" style="color: var(--text-faint)">
        Contact
      </h2>
      <p style="color: var(--text-muted)">
        Have comments, questions, or feature requests? Send me an email at <a
          href={`mailto:${SITE.email}`}
          class="underline underline-offset-2"
          style="color: var(--color-amber)">{SITE.email}</a
        >!
      </p>
    </section>
  </div>
</BaseLayout>
