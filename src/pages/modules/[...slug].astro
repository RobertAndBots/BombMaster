---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Practice from '../../components/Practice.astro'
import { manualPage } from '../../consts'

// One static page per module .mdx. Adding a module is adding a file — there is
// no route list to update, which is what the old site's hand-maintained
// router.jsx array required.
export async function getStaticPaths() {
  const showDrafts = import.meta.env.SHOW_DRAFTS === '1'
  const modules = await getCollection('modules', ({ data }) => showDrafts || !data.draft)
  const sorted = modules.sort((a, b) => a.data.order - b.data.order)

  return sorted.map((entry, idx) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: sorted[idx - 1],
      next: sorted[idx + 1],
    },
  }))
}

const { entry, prev, next } = Astro.props
const { Content } = await render(entry)
const { title, manualPage: page, hasDrill } = entry.data
---

<BaseLayout title={title} description={`How to memorize ${title} from the Keep Talking and Nobody Explodes manual.`} activeSlug={entry.id}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <header class="mb-6">
      <h1 class="text-3xl font-semibold tracking-tight">{title}</h1>
      <a
        href={manualPage(page)}
        target="_blank"
        rel="noopener"
        class="mt-2 inline-block text-sm underline underline-offset-2"
        style="color: var(--color-amber)"
      >
        Manual p{page} &#8599;
      </a>
    </header>

    {
      hasDrill ? (
        <>
          <div class="tabs mb-8" role="tablist" aria-label="Learn or practice">
            <button type="button" role="tab" id="tab-learn" aria-controls="panel-learn" aria-selected="true">
              Learn
            </button>
            <button type="button" role="tab" id="tab-practice" aria-controls="panel-practice" aria-selected="false" tabindex="-1">
              Practice
            </button>
          </div>
          <div class="prose" id="panel-learn" role="tabpanel" aria-labelledby="tab-learn">
            <Content />
          </div>
          <div id="panel-practice" role="tabpanel" aria-labelledby="tab-practice" hidden>
            <Practice slug={entry.id} />
          </div>
        </>
      ) : (
        <div class="prose">
          <Content />
        </div>
      )
    }

    <nav
      class="mt-16 flex flex-col sm:flex-row gap-3 justify-between border-t pt-6 text-sm"
      style="border-color: var(--border)"
      aria-label="Module navigation"
    >
      {
        prev ? (
          <a href={`/modules/${prev.id}/`} style="color: var(--text-muted)">
            &#8592; {prev.data.title}
          </a>
        ) : (
          <a href="/" style="color: var(--text-muted)">&#8592; All modules</a>
        )
      }
      {
        next && (
          <a href={`/modules/${next.id}/`} class="sm:text-right" style="color: var(--text-muted)">
            {next.data.title} &#8594;
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>

<script>
  // Learn | Practice. The chosen tab lives in the URL hash, so a link to
  // /modules/memory/#practice opens straight onto the drill.
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tabs [role="tab"]')

  function select(name: 'learn' | 'practice') {
    tabs.forEach((tab) => {
      const on = tab.id === `tab-${name}`
      tab.setAttribute('aria-selected', String(on))
      tab.tabIndex = on ? 0 : -1
      document.getElementById(tab.getAttribute('aria-controls')!)!.hidden = !on
    })
  }

  if (tabs.length) {
    const fromHash = () => select(location.hash === '#practice' ? 'practice' : 'learn')
    fromHash()
    window.addEventListener('hashchange', fromHash)

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const name = tab.id === 'tab-practice' ? 'practice' : 'learn'
        history.replaceState(null, '', name === 'practice' ? '#practice' : location.pathname)
        select(name)
      })
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return
        const other = [...tabs].find((t) => t !== tab)!
        other.click()
        other.focus()
      })
    })
  }
</script>
